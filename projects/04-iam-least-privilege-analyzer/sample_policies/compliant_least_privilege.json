{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlySpecificS3Bucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::company-app-assets-production",
        "arn:aws:s3:::company-app-assets-production/*"
      ]
    }
  ]
}
